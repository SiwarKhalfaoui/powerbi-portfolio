# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────────
# Local dev default matches docker-compose.yml at the repo root
DATABASE_URL="postgresql://drd_user:drd_password@localhost:5432/drd_portfolio?schema=public"

# ── JWT ───────────────────────────────────────────────────
# Generate strong secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Cookies ───────────────────────────────────────────────
# Set to "true" only when serving the API over HTTPS in production
COOKIE_SECURE=false

# ── Google Sign-In ────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console (no client secret needed —
# we only verify ID tokens server-side, we don't do a code exchange).
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com