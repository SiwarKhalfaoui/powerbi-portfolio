// Prisma schema — Dr.D Portfolio Platform
// Module 1: Authentication + User profile.
// Module 2: Power BI projects (this file).
// Future modules (public portfolios, gallery) will add new models here and
// relate them to User / Project via foreign keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Availability {
  FREELANCE
  CDI
  STAGE
  CONSULTANT
  NOT_SPECIFIED
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String

  // Identity
  firstName         String
  lastName          String
  professionalTitle String?
  bio               String?      @db.Text
  profilePhotoUrl   String?

  // Location & languages
  country           String?
  city              String?
  languages         String[]     @default([])

  // Professional
  skills            String[]     @default([])
  availability      Availability @default(NOT_SPECIFIED)
  services          String[]     @default([])

  // External links
  linkedinUrl       String?
  githubUrl         String?
  websiteUrl        String?
  publicContactEmail String?

  // Public portfolio (Module 3)
  slug               String?  @unique
  portfolioPublished Boolean  @default(false)

  // Access control
  role              Role         @default(USER)
  isEmailVerified   Boolean      @default(false)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  projects            Project[]
  experiences         Experience[]
  formations          Formation[]
  certifications      Certification[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum ProjectType {
  DASHBOARD
  REPORT
  ANALYSIS
  TEMPLATE
  CASE_STUDY
}

enum ProjectLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  PRIVATE
  ARCHIVED
}


model Project {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title            String
  slug             String  @unique
  shortDescription String?
  description      String? @db.Text

  businessDomain BusinessDomain?
  projectType    ProjectType  @default(DASHBOARD)
  toolsUsed      String[]     @default([])
  level          ProjectLevel @default(BEGINNER)

  coverImageUrl    String?
  galleryImageUrls String[] @default([])

  interactiveLink    String?
  ownershipConfirmed Boolean @default(false)
  videoUrl           String?
  datasetUrl         String?

  results String?  @db.Text
  tags    String[] @default([])

  status    ProjectStatus @default(DRAFT)
  viewCount Int           @default(0)

  order Int @default(0) @map("display_order")

  isFeatured Boolean @default(false)

  views ProjectView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([slug])
  @@map("projects")
}

// doc Module 6 — "tri par nombre de vues", fiabilisé : une ligne par
// (projet, visiteur) dans une fenêtre de 24h, plutôt qu'un simple compteur
// incrémenté à chaque chargement de page. visitorKey vaut "user:<id>" pour
// un visiteur connecté, "anon:<uuid>" pour un visiteur anonyme identifié
// via un identifiant généré côté navigateur (jamais lié à un compte).
model ProjectView {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitorKey String
  viewedAt   DateTime @default(now())

  @@index([projectId, visitorKey, viewedAt])
  @@map("project_views")
}


model Experience {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  company     String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("experiences")
}


model Formation {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  degree      String
  institution String
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("formations")
}


model Certification {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  issuer        String
  issueDate     DateTime?
  credentialUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@map("certifications")
}

enum BusinessDomain {
  FINANCE
  COMMERCIAL
  HR
  MARKETING
  SUPPLY_CHAIN
  LOGISTICS
  HEALTHCARE
  EDUCATION
  REAL_ESTATE
  PRODUCTION
  ECOMMERCE
  ESG
  DATA_ENGINEERING
  MICROSOFT_FABRIC
  ARTIFICIAL_INTELLIGENCE
  OTHER
}